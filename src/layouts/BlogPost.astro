---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { siteConfig } from '../../site.config';
import { t, getLanguage } from '../i18n';
import '../styles/table-of-contents.css';
import '../styles/callout.css';

// フォールバック用のデフォルトhero画像
import defaultHeroLight from '../assets/itzpapa-light_16_9.png';
import defaultHeroDark from '../assets/itzpapa-dark_16_9.png';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: Array<{ depth: number; text: string; slug: string }>;
  readingTime?: number;
  slug?: string;
  /** コメントセクションを表示するか（デフォルト: true） */
  showComments?: boolean;
  /** ライトモード用ヒーロー画像（ダークモード対応時に使用） */
  imageLight?: ImageMetadata;
  /** ダークモード用ヒーロー画像（ダークモード対応時に使用） */
  imageDark?: ImageMetadata;
};

const { title, description, published, updated, image, imageLight, imageDark, tags, category, headings = [], readingTime, slug, showComments = true } = Astro.props;

// カテゴリが有効かどうかをチェック
const hasCategory = category && category.trim() !== '';

// 機能フラグを取得
const { features, site } = siteConfig;
const lang = getLanguage();

// 記事の絶対URL
const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();

// OG画像URL（imageがある場合）
const ogImageUrl = image ? new URL(image.src, Astro.site).toString() : undefined;

// ヒーロー画像preload情報（LCP最適化）
// ライトモード画像を優先（ほとんどのユーザーのデフォルト設定）
const getHeroPreload = (): { src: string; type?: string } | undefined => {
  // カスタムヒーロー画像がある場合（ライト/ダーク分離）
  if (imageLight) {
    return { src: imageLight.src, type: 'image/webp' };
  }
  // 単一ヒーロー画像がある場合
  if (image) {
    return { src: image.src, type: 'image/webp' };
  }
  // 本番環境: 動的生成画像
  if (!import.meta.env.DEV && slug) {
    return { src: `/hero/${slug}-light.png`, type: 'image/png' };
  }
  // 開発環境: デフォルト画像
  if (import.meta.env.DEV) {
    return { src: defaultHeroLight.src, type: 'image/webp' };
  }
  return undefined;
};
const heroPreload = getHeroPreload();

// パンくずリスト用データ
const breadcrumbItems = [
  { name: t('breadcrumb.home'), url: site.baseUrl + '/' },
  { name: t('breadcrumb.blog'), url: site.baseUrl + '/blog/' },
  { name: title, url: articleUrl },
];
const showTableOfContents = features.tableOfContents;
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			slug={slug}
			article={{
				publishedTime: published,
				modifiedTime: updated,
				tags: tags,
			}}
			heroPreload={heroPreload}
		/>
		<JsonLd
			type="article"
			article={{
				title,
				description,
				datePublished: published,
				dateModified: updated,
				image: ogImageUrl,
				tags,
				url: articleUrl,
			}}
		/>
		<JsonLd type="breadcrumb" breadcrumbs={breadcrumbItems} />
		<style>
			/* 検索ハイライト（動的に作成されるため :global() が必要） */
			:global(.search-highlight) {
				background-color: var(--mark-bg, oklch(90% 0.20 calc(var(--primary-hue) + 180) / 0.6));
				color: var(--color-text-primary);
				padding: 0.1em 0.2em;
				border-radius: 0.2em;
			}

			/* アニメーションは別クラスで適用（スクロール完了後に付与） */
			:global(.search-highlight.animate) {
				animation: highlight-pulse 1s ease-out;
			}

			@keyframes highlight-pulse {
				0% {
					background-color: oklch(80% 0.30 calc(var(--primary-hue) + 180));
				}
				100% {
					background-color: var(--mark-bg, oklch(90% 0.20 calc(var(--primary-hue) + 180) / 0.6));
				}
			}

			:global(html.dark .search-highlight) {
				background-color: var(--mark-bg-dark, oklch(85% 0.18 calc(var(--primary-hue) + 180) / 0.4));
			}

			/* メインコンテナ */
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			/* パンくずナビゲーション */
			.breadcrumb-container {
				max-width: 960px;
				margin: var(--space-2) auto var(--space-4);
				padding: 0 var(--space-4);
			}

			/* ヒーロー画像 */
			.hero-image {
				width: 100%;
				max-width: 960px;
				margin: 0 auto var(--space-8);
				overflow: hidden;
				border-radius: var(--radius-2xl);
			}

			.hero-image img {
				display: block;
				width: 100%;
				max-width: 100%;
				height: auto;
				margin: 0 auto;
				box-shadow: var(--shadow-lg);
				object-fit: cover;
				aspect-ratio: 2 / 1;
			}

			/* デフォルトhero画像のダークモード切り替え */
			.hero-image img.hero-image--light {
				display: block;
			}

			.hero-image img.hero-image--dark {
				display: none;
			}

			html.dark .hero-image img.hero-image--light {
				display: none;
			}

			html.dark .hero-image img.hero-image--dark {
				display: block;
			}

			/* 画像読み込み中のスケルトン表示 */
			.hero-image img:not([src]) {
				background: linear-gradient(
					90deg,
					var(--color-gray-100) 25%,
					var(--color-gray-200) 50%,
					var(--color-gray-100) 75%
				);
				background-size: 200% 100%;
				animation: loading 1.5s ease-in-out infinite;
			}

			@keyframes loading {
				0% { background-position: 200% 0; }
				100% { background-position: -200% 0; }
			}

			/* 記事コンテンツ */
			.prose {
				max-width: 720px;
				width: calc(100% - 2em);
				margin: auto;
				padding: var(--space-4) var(--space-6);
				color: var(--color-text-primary);
			}

			/* 本文エリアの背景分離 */
			.prose.blog-content {
				background-color: var(--article-bg);
				border-radius: var(--radius-xl);
				padding: var(--space-8) var(--space-10);
				box-shadow: var(--article-shadow);
			}

			/* 記事ヘッダー */
			.article-header {
				margin-bottom: var(--space-8);
				padding: var(--space-6) 0;
				text-align: center;
				border-bottom: 1px solid var(--color-gray-200);
			}

			.article-header h1 {
				font-size: var(--font-size-4xl);
				font-weight: var(--font-weight-bold);
				color: var(--color-text-primary);
				line-height: var(--line-height-tight);
				margin: 0 0 var(--space-4) 0;
			}

			/* メタデータ */
			.article-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: var(--space-4);
				margin-bottom: var(--space-4);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.article-meta__item {
				display: flex;
				align-items: center;
				gap: var(--space-2);
			}

			.article-meta__icon {
				font-size: var(--font-size-base);
				width: 1.5em;
				min-width: 1.5em;
				display: inline-flex;
				justify-content: center;
				align-items: center;
				flex-shrink: 0;
			}

			.article-meta__published {
				color: var(--color-text-accent);
				font-weight: var(--font-weight-medium);
			}

			.article-meta__reading-time {
				color: var(--color-text-secondary);
			}

			.article-meta__updated {
				/* markスタイルを適用 */
				background-color: var(--mark-bg, oklch(90% 0.20 calc(var(--primary-hue) + 180) / 0.6));
				color: var(--color-text-primary);
				padding: 0.1em 0.25em;
				border-radius: 0.2em;
			}

			html.dark .article-meta__updated {
				background-color: var(--mark-bg-dark, oklch(85% 0.18 calc(var(--primary-hue) + 180) / 0.4));
			}

			/* カテゴリ・タグ行 */
			.article-category-tags {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: flex-start;
				gap: var(--space-3);
				margin: var(--space-4) 0;
			}

			.article-category-tags__separator {
				color: var(--color-gray-400);
				font-size: var(--font-size-lg);
			}

			html.dark .article-category-tags__separator {
				color: var(--color-gray-500);
			}

			/* タグ */
			.article-tags {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: var(--space-2);
			}

			/* 記事フッター */
			.article-footer-tags {
				margin-top: var(--space-12);
				padding-top: var(--space-6);
				border-top: 1px solid var(--color-gray-200);
			}

			.article-footer-tags h3 {
				margin-bottom: var(--space-4);
				font-size: var(--font-size-lg);
				font-weight: var(--font-weight-semibold);
				color: var(--color-text-primary);
			}

			/* 目次ありの場合の調整 */
			.blog-layout-with-toc .prose {
				max-width: 100%;
				width: 100%;
				padding: 0;
			}

			/* レスポンシブ: タブレット */
			@media (min-width: 768px) {
				.article-header h1 {
					font-size: var(--font-size-5xl);
				}

				.blog-layout-with-toc .blog-content {
					padding: 0 var(--space-6);
					box-sizing: border-box;
				}
			}

			/* レスポンシブ: モバイル */
			@media (max-width: 767px) {
				.hero-image {
					border-radius: var(--radius-xl);
					margin: 0 var(--space-4) var(--space-6);
					width: calc(100% - var(--space-4) * 2);
				}

				.hero-image img {
					aspect-ratio: 16 / 9;
				}

				.prose {
					width: 100%;
					padding: var(--space-4);
					box-sizing: border-box;
				}

				.prose.blog-content {
					padding: var(--space-4) var(--space-6);
					border-radius: var(--radius-lg);
					margin: 0 var(--space-2);
					width: calc(100% - var(--space-4));
				}

				.blog-layout-with-toc .blog-content {
					padding: var(--space-4) var(--space-6);
				}

				.article-header {
					padding: var(--space-4) 0;
				}

				.article-header h1 {
					font-size: var(--font-size-2xl);
				}

				.article-meta {
					display: inline-flex;
					flex-direction: column;
					gap: var(--space-2);
					align-items: flex-start;
				}
			}

			/* ダークモード */
			html.dark .article-header {
				border-bottom-color: var(--color-gray-700);
			}

			html.dark .article-footer-tags {
				border-top-color: var(--color-gray-700);
			}
		</style>
	</head>

	<body>
		<Header />
		<main style="view-transition-name: main-content;">
			<article>
				<div class="breadcrumb-container">
					<Breadcrumb items={[
						{ label: t('breadcrumb.home'), href: '/' },
						{ label: t('breadcrumb.blog'), href: '/blog/' },
						{ label: title }
					]} />
				</div>
				<div class="hero-image">
					{imageLight && imageDark ? (
						<>
							<Image width={1020} height={510} src={imageLight} alt="" loading="eager" decoding="async" format="webp" fetchpriority="high" class="hero-image--light" />
							<Image width={1020} height={510} src={imageDark} alt="" loading="eager" decoding="async" format="webp" fetchpriority="high" class="hero-image--dark" />
						</>
					) : image ? (
						<Image width={1020} height={510} src={image} alt="" loading="eager" decoding="async" format="webp" fetchpriority="high" />
					) : import.meta.env.DEV ? (
						/* dev環境: フォールバック画像を使用（動的生成が機能しないため） */
						<>
							<Image width={1020} height={510} src={defaultHeroLight} alt="" loading="eager" decoding="async" format="webp" fetchpriority="high" class="hero-image--light" />
							<Image width={1020} height={510} src={defaultHeroDark} alt="" loading="eager" decoding="async" format="webp" fetchpriority="high" class="hero-image--dark" />
						</>
					) : (
						/* 本番環境: ビルド時に生成されたタイトル入り画像を使用 */
						<>
							<img width="1020" height="510" src={`/hero/${slug}-light.png`} alt="" loading="eager" decoding="async" fetchpriority="high" class="hero-image--light" />
							<img width="1020" height="510" src={`/hero/${slug}-dark.png`} alt="" loading="eager" decoding="async" fetchpriority="high" class="hero-image--dark" />
						</>
					)}
				</div>
				<div class={showTableOfContents && headings && headings.length > 0 ? "blog-layout-with-toc" : ""}>
					<div class="prose blog-content">
						<header class="article-header">
							<div class="article-meta">
								<span class="article-meta__item">
									<span class="article-meta__icon" aria-hidden="true">📅</span>
									<span class="article-meta__published">
										<FormattedDate date={published} />
									</span>
								</span>
								{updated && (
									<span class="article-meta__item">
										<span class="article-meta__icon" aria-hidden="true">🔄</span>
										<span class="article-meta__updated">
											<FormattedDate date={updated} />
										</span>
									</span>
								)}
								{readingTime && (
									<span class="article-meta__item">
										<span class="article-meta__icon" aria-hidden="true">⏱️</span>
										<span class="article-meta__reading-time">{t('article.readingTime').replace('{min}', String(readingTime))}</span>
									</span>
								)}
							</div>
							<h1>{title}</h1>
							{(hasCategory || (tags && tags.length > 0)) && (
								<div class="article-category-tags">
									{hasCategory && (
										<CategoryBadge
											category={category}
											href={`/category/${category.toLowerCase()}/`}
										/>
									)}
									{hasCategory && tags && tags.length > 0 && (
										<span class="article-category-tags__separator" aria-hidden="true">|</span>
									)}
									{tags && tags.length > 0 && (
										<div class="article-tags">
											<TagList tags={tags} layout="horizontal" />
										</div>
									)}
								</div>
							)}
						</header>
						<slot />
						{tags && tags.length > 0 && (
							<footer class="article-footer-tags">
								<h3>{t('article.relatedTags')}</h3>
								<TagList tags={tags} layout="horizontal" showCount={false} />
							</footer>
						)}
					</div>
					{showTableOfContents && headings && headings.length > 0 && (
						<aside class="toc-sidebar">
							<TableOfContents headings={headings} />
						</aside>
					)}
				</div>
				<!-- コメントセクション -->
				{showComments && <Comments articleUrl={articleUrl} articleTitle={title} />}
				<!-- 関連記事セクション -->
				{features.relatedPosts && tags && tags.length > 0 && slug && (
					<RelatedPosts currentPostId={slug} currentTags={tags} currentCategory={category} />
				)}
			</article>
		</main>
		<Footer />

		<!-- Image Lightbox -->
		<ImageLightbox />

		<!-- Search highlight and scroll functionality -->
		<script>
			function initSearchHighlight() {
				// URLパラメータからハイライト対象を取得
				const params = new URLSearchParams(window.location.search);
				const highlightQuery = params.get('highlight');

				if (!highlightQuery || !highlightQuery.trim()) return;

				const query = highlightQuery.trim();
				const content = document.querySelector('.prose.blog-content');
				if (!content) return;

				// 既存のハイライトをクリア
				const existingHighlights = content.querySelectorAll('.search-highlight');
				existingHighlights.forEach(el => {
					const parent = el.parentNode;
					if (parent) {
						parent.replaceChild(document.createTextNode(el.textContent || ''), el);
						parent.normalize();
					}
				});

				// テキストノードを走査してハイライト
				const walker = document.createTreeWalker(
					content,
					NodeFilter.SHOW_TEXT,
					{
						acceptNode: (node) => {
							// スクリプトやスタイル、コードブロック内のテキストは除外
							const parent = node.parentElement;
							if (!parent) return NodeFilter.FILTER_REJECT;
							// 祖先要素にscript/style/code/preがあれば除外（Shikiのspan対応）
							if (parent.closest('script, style, code, pre')) {
								return NodeFilter.FILTER_REJECT;
							}
							return NodeFilter.FILTER_ACCEPT;
						}
					}
				);

				const textNodes = [];
				let node;
				while ((node = walker.nextNode())) {
					textNodes.push(node);
				}

				let firstHighlight = null;
				const queryLower = query.toLowerCase();

				for (const textNode of textNodes) {
					const text = textNode.textContent || '';
					const textLower = text.toLowerCase();
					const index = textLower.indexOf(queryLower);

					if (index !== -1) {
						// テキストノードを分割してハイライト
						const before = text.slice(0, index);
						const match = text.slice(index, index + query.length);
						const after = text.slice(index + query.length);

						const span = document.createElement('span');
						span.className = 'search-highlight';
						span.textContent = match;

						const fragment = document.createDocumentFragment();
						if (before) fragment.appendChild(document.createTextNode(before));
						fragment.appendChild(span);
						if (after) fragment.appendChild(document.createTextNode(after));

						const parent = textNode.parentNode;
						if (parent) {
							parent.replaceChild(fragment, textNode);
						}

						if (!firstHighlight) {
							firstHighlight = span;
						}
					}
				}

				// 最初のハイライト箇所にスクロール
				if (firstHighlight) {
					// 少し遅延してスクロール（レンダリング完了を待つ）
					setTimeout(() => {
						// スクロール完了後にアニメーションを開始
						const onScrollEnd = () => {
							firstHighlight.classList.add('animate');
							window.removeEventListener('scrollend', onScrollEnd);
						};
						window.addEventListener('scrollend', onScrollEnd, { once: true });

						firstHighlight.scrollIntoView({ behavior: 'smooth', block: 'center' });

						// フォールバック: scrollendがサポートされていない場合や、スクロール不要な場合
						setTimeout(() => {
							if (!firstHighlight.classList.contains('animate')) {
								firstHighlight.classList.add('animate');
								window.removeEventListener('scrollend', onScrollEnd);
							}
						}, 1000);
					}, 100);
				}
			}

			// Run on initial load
			initSearchHighlight();

			// Re-run after View Transitions (Astro)
			document.addEventListener('astro:page-load', initSearchHighlight);
		</script>

		<!-- Callout folding functionality -->
		<script>
			function initCalloutFolding() {
				const foldableCallouts = document.querySelectorAll('blockquote[data-callout-foldable="true"]');

				foldableCallouts.forEach((callout) => {
					// Set initial collapsed state based on data-callout-folded attribute
					const initiallyFolded = callout.getAttribute('data-callout-folded') === 'true';
					if (initiallyFolded) {
						callout.setAttribute('data-callout-collapsed', 'true');
					}

					// Create a clickable title overlay
					const titleOverlay = document.createElement('div');
					titleOverlay.className = 'callout-title-overlay';
					titleOverlay.setAttribute('role', 'button');
					titleOverlay.setAttribute('tabindex', '0');
					titleOverlay.setAttribute('aria-expanded', initiallyFolded ? 'false' : 'true');

					// Insert the overlay at the beginning of the callout
					callout.insertBefore(titleOverlay, callout.firstChild);

					// Add fold icon
					const foldIcon = document.createElement('span');
					foldIcon.className = 'callout-fold-icon';
					foldIcon.setAttribute('aria-hidden', 'true');
					titleOverlay.appendChild(foldIcon);

					// Toggle function
					const toggleCallout = () => {
						const isCollapsed = callout.getAttribute('data-callout-collapsed') === 'true';
						if (isCollapsed) {
							callout.removeAttribute('data-callout-collapsed');
							titleOverlay.setAttribute('aria-expanded', 'true');
						} else {
							callout.setAttribute('data-callout-collapsed', 'true');
							titleOverlay.setAttribute('aria-expanded', 'false');
						}
					};

					// Click handler
					titleOverlay.addEventListener('click', toggleCallout);

					// Keyboard handler for accessibility
					titleOverlay.addEventListener('keydown', (e) => {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							toggleCallout();
						}
					});
				});
			}

			// Run on initial load
			initCalloutFolding();

			// Re-run after View Transitions (Astro)
			document.addEventListener('astro:page-load', initCalloutFolding);
		</script>
	</body>
</html>
