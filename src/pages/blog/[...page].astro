---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostsGrid from '../../components/PostsGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { siteConfig, SITE_TITLE } from '../../../site.config';
import { getSiteDescription } from '../../i18n';
import { t, getLanguage } from '../../i18n';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	// 設定からページサイズを取得（デフォルト24件）
	const postsPerPage = siteConfig.pagination?.postsPerPage ?? 24;

	const posts = (await getCollection('blog', ({ data }) => {
		// 本番環境ではdraft: trueの記事を除外
		return import.meta.env.PROD ? data.draft !== true : true;
	})).sort((a, b) => {
		// 更新日時順でソート（updatedがない場合はpublishedを使用）
		const dateA = a.data.updated ?? a.data.published;
		const dateB = b.data.updated ?? b.data.published;
		return dateB.valueOf() - dateA.valueOf();
	});

	return paginate(posts, {
		pageSize: postsPerPage,
	});
};

const { page } = Astro.props;
const lang = getLanguage();

// ページ番号に応じたタイトルを生成
const isFirstPage = page.currentPage === 1;
const pageTitleBase = isFirstPage
	? t('blog.pageTitle')
	: t('blog.pageTitle.paginated').replace('{page}', String(page.currentPage));
const pageTitle = `${pageTitleBase} | ${SITE_TITLE}`;
const siteDescription = getSiteDescription();

// SEO用のprev/next URL
const baseUrl = siteConfig.site.baseUrl;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={pageTitle}
			description={siteDescription}
			pagination={{
				currentPage: page.currentPage,
				lastPage: page.lastPage,
				prevUrl: page.url.prev,
				nextUrl: page.url.next,
			}}
		/>
		<style>
			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: var(--space-8) var(--space-4);
			}

			.page-header {
				text-align: center;
				margin-bottom: var(--space-12);
			}

			.page-header h1 {
				font-size: var(--font-size-4xl);
				font-weight: var(--font-weight-bold);
				color: var(--color-text-primary);
				margin: 0 0 var(--space-4) 0;
			}

			.page-header p {
				font-size: var(--font-size-lg);
				color: var(--color-text-secondary);
				margin: 0;
			}

			/* レスポンシブ: モバイル */
			@media (max-width: 767px) {
				main {
					padding: var(--space-6) var(--space-4);
				}

				.page-header h1 {
					font-size: var(--font-size-2xl);
				}

				.page-header p {
					font-size: var(--font-size-base);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="view-transition-name: main-content;">
			<Breadcrumb items={[
				{ label: t('breadcrumb.home'), href: '/' },
				{ label: t('breadcrumb.blog') }
			]} />
			<header class="page-header">
				<h1>{t('blog.title')}</h1>
				<p>{t('blog.description')}</p>
			</header>
			<PostsGrid posts={page.data} />

			{/* ページ数が2以上の場合のみページネーションを表示 */}
			{page.lastPage > 1 && (
				<Pagination
					currentPage={page.currentPage}
					lastPage={page.lastPage}
					prevUrl={page.url.prev}
					nextUrl={page.url.next}
					baseUrl="/blog/"
				/>
			)}
		</main>
		<Footer />
	</body>
</html>
