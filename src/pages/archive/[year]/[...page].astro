---
/**
 * 年別アーカイブページ（ページネーション対応）
 * 特定年の記事をカード形式・ページネーション付きで表示
 */

import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostsGrid from '../../../components/PostsGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import { t, getLanguage } from '../../../i18n';
import { siteConfig, SITE_TITLE } from '../../../../site.config';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const postsPerPage = siteConfig.pagination?.postsPerPage ?? 24;

  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  // 年ごとにグループ化
  const yearMap = new Map<number, typeof allPosts>();

  allPosts.forEach(post => {
    const year = new Date(post.data.published).getFullYear();
    if (!yearMap.has(year)) {
      yearMap.set(year, []);
    }
    yearMap.get(year)!.push(post);
  });

  // 各年のページを生成
  const paths = [];
  for (const [year, posts] of yearMap.entries()) {
    // 公開日の降順でソート
    const sortedPosts = posts.sort((a, b) =>
      new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
    );

    const yearPages = paginate(sortedPosts, {
      pageSize: postsPerPage,
      params: { year: String(year) },
    });

    paths.push(...yearPages);
  }

  return paths;
};

const { page } = Astro.props;
const { year } = Astro.params;
const lang = getLanguage();

// ページメタデータ
const yearNum = Number(year);
const yearText = lang === 'ja' ? `${year}年` : String(year);
const isFirstPage = page.currentPage === 1;
const pageTitleBase = t('archive.yearPosts').replace('{year}', String(year));
const pageTitle = isFirstPage
  ? `${pageTitleBase} | ${SITE_TITLE}`
  : `${pageTitleBase} - Page ${page.currentPage} | ${SITE_TITLE}`;
const pageDescription = lang === 'ja'
  ? `${year}年に公開された${page.total}件の記事を表示しています。`
  : `Showing ${page.total} posts published in ${year}.`;

// ページネーション用のベースURL
const baseUrl = `/archive/${year}/`;
---

<html lang={lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
      }}
    />
    <style>
      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: var(--space-8) var(--space-4);
      }

      .page-header {
        text-align: center;
        margin-bottom: var(--space-12);
      }

      .page-header h1 {
        font-size: var(--font-size-4xl);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-primary);
        margin: 0 0 var(--space-4) 0;
      }

      .page-header p {
        font-size: var(--font-size-lg);
        color: var(--color-text-secondary);
        margin: 0;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-link);
        text-decoration: none;
        margin-bottom: var(--space-4);
        font-size: var(--font-size-sm);
        transition: color var(--duration-fast) var(--easing-default);
      }

      .back-link:hover {
        text-decoration: underline;
      }

      .back-link svg {
        width: 16px;
        height: 16px;
      }

      /* レスポンシブ: モバイル */
      @media (max-width: 767px) {
        main {
          padding: var(--space-6) var(--space-4);
        }

        .page-header h1 {
          font-size: var(--font-size-2xl);
        }

        .page-header p {
          font-size: var(--font-size-base);
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main style="view-transition-name: main-content;">
      <Breadcrumb items={[
        { label: t('breadcrumb.home'), href: '/' },
        { label: t('breadcrumb.archive'), href: '/archive/' },
        { label: yearText }
      ]} />

      <a href="/archive/" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M12.5 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H12a.5.5 0 0 1 .5.5z"/>
        </svg>
        {t('archive.backToArchive')}
      </a>

      <header class="page-header">
        <h1>{pageTitleBase}</h1>
        <p>{pageDescription}</p>
      </header>

      <PostsGrid posts={page.data} />

      {page.lastPage > 1 && (
        <Pagination
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          baseUrl={baseUrl}
        />
      )}
    </main>
    <Footer />
  </body>
</html>
