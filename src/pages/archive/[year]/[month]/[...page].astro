---
/**
 * 月別アーカイブページ（ページネーション対応）
 * 特定月の記事をカード形式・ページネーション付きで表示
 */

import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../../../../components/BaseHead.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostsGrid from '../../../../components/PostsGrid.astro';
import Pagination from '../../../../components/Pagination.astro';
import { t, getLanguage } from '../../../../i18n';
import { siteConfig, SITE_TITLE } from '../../../../../site.config';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const postsPerPage = siteConfig.pagination?.postsPerPage ?? 24;

  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  // 年月ごとにグループ化
  const yearMonthMap = new Map<string, typeof allPosts>();

  allPosts.forEach(post => {
    const date = new Date(post.data.published);
    const year = date.getFullYear();
    const month = date.getMonth() + 1;
    const key = `${year}-${String(month).padStart(2, '0')}`;

    if (!yearMonthMap.has(key)) {
      yearMonthMap.set(key, []);
    }
    yearMonthMap.get(key)!.push(post);
  });

  // 各年月のページを生成
  const paths = [];
  for (const [key, posts] of yearMonthMap.entries()) {
    const [year, month] = key.split('-');

    // 公開日の降順でソート
    const sortedPosts = posts.sort((a, b) =>
      new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
    );

    const monthPages = paginate(sortedPosts, {
      pageSize: postsPerPage,
      params: { year, month },
    });

    paths.push(...monthPages);
  }

  return paths;
};

const { page } = Astro.props;
const { year, month } = Astro.params;
const lang = getLanguage();

// 月名を取得する関数
function getMonthName(month: number, lang: string): string {
  const date = new Date(2024, month - 1, 1);
  return date.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', { month: 'long' });
}

// ページメタデータ
const yearNum = Number(year);
const monthNum = Number(month);
const monthName = getMonthName(monthNum, lang);
const yearText = lang === 'ja' ? `${year}年` : String(year);
const monthText = lang === 'ja' ? `${monthNum}月` : monthName;
const isFirstPage = page.currentPage === 1;
const pageTitleBase = lang === 'ja'
  ? t('archive.monthPosts').replace('{year}', String(year)).replace('{month}', String(monthNum))
  : t('archive.monthPosts').replace('{year}', String(year)).replace('{month}', monthName);
const pageTitle = isFirstPage
  ? `${pageTitleBase} | ${SITE_TITLE}`
  : `${pageTitleBase} - Page ${page.currentPage} | ${SITE_TITLE}`;
const pageDescription = lang === 'ja'
  ? `${year}年${monthNum}月に公開された${page.total}件の記事を表示しています。`
  : `Showing ${page.total} posts published in ${monthName} ${year}.`;

// ページネーション用のベースURL
const baseUrl = `/archive/${year}/${month}/`;
---

<html lang={lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
      }}
    />
    <style>
      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: var(--space-8) var(--space-4);
      }

      .page-header {
        text-align: center;
        margin-bottom: var(--space-12);
      }

      .page-header h1 {
        font-size: var(--font-size-4xl);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-primary);
        margin: 0 0 var(--space-4) 0;
      }

      .page-header p {
        font-size: var(--font-size-lg);
        color: var(--color-text-secondary);
        margin: 0;
      }

      .back-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin-bottom: var(--space-4);
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-link);
        text-decoration: none;
        font-size: var(--font-size-sm);
        transition: color var(--duration-fast) var(--easing-default);
      }

      .back-link:hover {
        text-decoration: underline;
      }

      .back-link svg {
        width: 16px;
        height: 16px;
      }

      /* レスポンシブ: モバイル */
      @media (max-width: 767px) {
        main {
          padding: var(--space-6) var(--space-4);
        }

        .page-header h1 {
          font-size: var(--font-size-2xl);
        }

        .page-header p {
          font-size: var(--font-size-base);
        }

        .back-links {
          flex-direction: column;
          gap: var(--space-2);
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main style="view-transition-name: main-content;">
      <Breadcrumb items={[
        { label: t('breadcrumb.home'), href: '/' },
        { label: t('breadcrumb.archive'), href: '/archive/' },
        { label: yearText, href: `/archive/${year}/` },
        { label: monthText }
      ]} />

      <div class="back-links">
        <a href="/archive/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
            <path fill-rule="evenodd" d="M12.5 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H12a.5.5 0 0 1 .5.5z"/>
          </svg>
          {t('archive.backToArchive')}
        </a>
        <a href={`/archive/${year}/`} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
            <path fill-rule="evenodd" d="M12.5 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H12a.5.5 0 0 1 .5.5z"/>
          </svg>
          {t('archive.backToYear').replace('{year}', String(year))}
        </a>
      </div>

      <header class="page-header">
        <h1>{pageTitleBase}</h1>
        <p>{pageDescription}</p>
      </header>

      <PostsGrid posts={page.data} />

      {page.lastPage > 1 && (
        <Pagination
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          baseUrl={baseUrl}
        />
      )}
    </main>
    <Footer />
  </body>
</html>
